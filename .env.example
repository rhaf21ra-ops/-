# Netlify > Site configuration > Environment variables (names only, never commit real values)
NEXT_PUBLIC_SUPABASE_URL=            # Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # Supabase > Project Settings > API > anon public key (safe for the browser)
SUPABASE_SERVICE_ROLE_KEY=           # Supabase > Project Settings > API > service_role (SERVER ONLY, mark as secret, never NEXT_PUBLIC_)
